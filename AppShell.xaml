<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:projectChurch.Views"
       x:Class="projectChurch.AppShell"
       BackgroundColor="{DynamicResource White}">


    <Shell.Resources >
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{DynamicResource LightGreen }" />
                <Setter Property="Shell.ForegroundColor" Value="{DynamicResource White}" />
                <Setter Property="Shell.TitleColor" Value="{DynamicResource White}" />
                <Setter Property="Shell.DisabledColor" Value="#B4FFFFFF" />
                <Setter Property="Shell.UnselectedColor" Value="#95FFFFFF" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource LightGreen }" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource White}"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="#95FFFFFF"/>
                <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource White}"/>
            </Style>
            <Style TargetType="TabBar" BasedOn="{StaticResource BaseStyle}" />
            <Style TargetType="FlyoutItem" BasedOn="{StaticResource BaseStyle}" />
        </ResourceDictionary>
    </Shell.Resources>
    <TabBar>
        <ShellContent Title="Home" Icon="book_icon.png"  ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Saved" Icon="book_icon.png" ContentTemplate="{DataTemplate views:PageA}" />
        <ShellContent Title="About" Icon="info_icon.png" ContentTemplate="{DataTemplate views:PageB}" />
    </TabBar>

   
</Shell>
