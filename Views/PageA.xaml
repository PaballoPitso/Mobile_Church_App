<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectChurch.Views.PageA"
             Title="SAVED"
             BackgroundColor="{DynamicResource White}">

    <ScrollView Padding="20" BackgroundColor="{DynamicResource White}">
        <CollectionView x:Name="EntryListView"
                    ItemsSource="{Binding Entries}"
                    SelectionMode="Single" BackgroundColor="{DynamicResource White}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    
                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" >
                        <Button Text="{Binding Title}" BackgroundColor="{DynamicResource LightGreen }" Clicked="Button_Clicked_1" Padding="10" FontSize="16" FontAttributes="Bold" Margin="3"/>
                        <Button Text="Delete" BackgroundColor="{DynamicResource LightGray}" Clicked="Button_Clicked" Padding="10" FontSize="16" FontAttributes="Bold" Margin="3" />
                        
                    </StackLayout>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </ScrollView>
   
</ContentPage>