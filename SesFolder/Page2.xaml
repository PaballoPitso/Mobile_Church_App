<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectChurch.Views.Page2"
             Title="LENANEO"
             BackgroundColor="{DynamicResource White}">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            IconImageSource="search.png"
            Order="Primary"
            Priority="0"
            Clicked="OnSearchClicked"/>
    </ContentPage.ToolbarItems>
    <CollectionView x:Name="EntriesCollView"
                 ItemsSource="{Binding Entries}"
                 SelectionMode="Single">
        <CollectionView.ItemTemplate>
        <DataTemplate>
                
                    <StackLayout  Orientation="Horizontal" HorizontalOptions="Center">
                    <Button Text="{Binding Title}" BackgroundColor="{DynamicResource Black}" TextColor="{DynamicResource White}" BorderColor="{DynamicResource LightGray}" BorderWidth="2"  WidthRequest="300" FontSize="16" FontAttributes="Bold" Margin="4" Clicked="Button_Clicked"/>
                    </StackLayout>
                
        </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>