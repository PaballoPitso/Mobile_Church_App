<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectChurch.SesFolder.displayPage"
             Title="{Binding Title}" BackgroundColor="{DynamicResource White}">
    <ContentPage.ToolbarItems >
        <ToolbarItem IconImageSource="save.png" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>
    <ScrollView BackgroundColor="{DynamicResource White}">

        <Label 
            Text="{Binding Content}"
            
            FontSize="22" 
            Padding="10"
            VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center"
            TextColor="{DynamicResource Black}"/>
        
    </ScrollView>
</ContentPage>